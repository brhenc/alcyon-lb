#
# Not installed by anything in the repository (T293). To use it:
#   cp tools/systemd/alcyon-difffuzz.* ~/.config/systemd/user/
#   edit WorkingDirectory to a checkout of main, then
#   systemctl --user daemon-reload && systemctl --user enable --now alcyon-difffuzz.timer
[Unit]
Description=Alcyon vs HAProxy differential fuzz soak (T293)

[Service]
Type=oneshot
# Edit both paths to your checkout (%h is your home directory), and set ALCYON_REFERENCE
# (README, "Running the oracle tests") in an Environment= line or a drop-in.
WorkingDirectory=%h/alcyon-lb
ExecStart=%h/alcyon-lb/tools/difffuzz_soak.sh 60
# exit 1 means "new DIFFs found" (see the report), not a unit failure worth restarting
SuccessExitStatus=0 1
Nice=19
