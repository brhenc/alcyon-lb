#
# Not installed by anything in the repository (T293). To use it:
#   cp tools/systemd/ibex-difffuzz.* ~/.config/systemd/user/
#   edit WorkingDirectory to a checkout of main, then
#   systemctl --user daemon-reload && systemctl --user enable --now ibex-difffuzz.timer
[Unit]
Description=Ibex vs HAProxy differential fuzz soak (T293)

[Service]
Type=oneshot
WorkingDirectory=%h/project-ibex
ExecStart=%h/project-ibex/tools/difffuzz_soak.sh 60
# exit 1 means "new DIFFs found" (see the report), not a unit failure worth restarting
SuccessExitStatus=0 1
Nice=19
