global
    nbthread 1
defaults
    mode http
    timeout client 10s
    timeout server 10s
    timeout connect 5s
frontend fe
    bind 127.0.0.1:@FE@
    default_backend be
backend be
    balance uri
    hash-type consistent
    server s1 127.0.0.1:@BE@
    server s2 127.0.0.1:@BE@
    server s3 127.0.0.1:@BE@
    server s4 127.0.0.1:@BE@
