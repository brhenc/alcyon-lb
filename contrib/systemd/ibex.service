#
# systemd unit for Ibex, modelled on HAProxy's admin/systemd/haproxy.service.in.
# Install as /etc/systemd/system/ibex.service; see docs/operating.md.

[Unit]
Description=Ibex Load Balancer
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/default/ibex
EnvironmentFile=-/etc/sysconfig/ibex
Environment="CONFIG=/etc/ibex/ibex.cfg" "PIDFILE=/run/ibex.pid" "EXTRAOPTS=-S /run/ibex-master.sock"
# -Ws: reload on SIGUSR2, and report READY=1 / RELOADING=1 / MAINPID= / STOPPING=1 to systemd.
ExecStart=/usr/local/sbin/ibex -Ws -f $CONFIG -p $PIDFILE $EXTRAOPTS
# Refuse the reload when the new configuration does not parse, then ask for it.
ExecReload=/usr/local/sbin/ibex -Ws -f $CONFIG -c $EXTRAOPTS
ExecReload=/bin/kill -USR2 $MAINPID
# SIGTERM to the main process only, then SIGKILL to the rest after TimeoutStopSec.
KillMode=mixed
Restart=always
Type=notify

# Sandboxing, as in HAProxy's unit; uncomment what your setup allows.
# A reload starts the new process from the same binary path, and it keeps its hand-over
# socket in the temporary directory ($TMPDIR, default /tmp), so do not make that directory
# unwritable for the service.
# NoNewPrivileges=true
# ProtectHome=true
# ProtectSystem=true
# ProtectKernelTunables=true
# ProtectKernelModules=true
# ProtectControlGroups=true
# SystemCallFilter=~@cpu-emulation @keyring @module @obsolete @raw-io

[Install]
WantedBy=multi-user.target
