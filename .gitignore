# Cargo output. Not anchored: stray target/ dirs have been created by running
# cargo inside crates/ibex-config and fuzz, and 79 MB of them reached the index.
target/
**/*.rs.bk
**/*.profraw
**/*.profdata
.DS_Store
.agy/
__pycache__/
*.pyc

# Agent scratch. Background agents write throwaway fix-up scripts into the repo root;
# these patterns keep them out of commits rather than relying on staging discipline.
/fix_*.py
/add_*.py
/insert_*.py
/*_fix.py
/clippy_output.json
/out.json
# Agent probe files: throwaway crates/**/scratch*.rs used to test whether a dependency
# resolves. They also block the next launch, because agy treats any uncommitted path as
# the supervisor's and refuses to claim it.
**/scratch*.rs
/modify*.py
/size_measure.rs
/test_*.rs
# allocprofile is standalone (outside the workspace), so it has its own lockfile/target
/tools/allocprofile/target
/tools/allocprofile/Cargo.lock

# Stray build artefacts: agent sessions have dropped .rlib files in the repo root.
*.rlib

# perf(1) output: T39 leaves perf.data in the repo root. 107 MB, and GitLab refuses
# blobs over 100 MB, so this one rejected a push of 49 other files.
perf.data
perf.data.old
*.perf
