[Unit]
Description=Alcyon Load Balancer
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/default/alcyon
EnvironmentFile=-/etc/sysconfig/alcyon
Environment="CONFIG=/etc/alcyon/alcyon.cfg" "PIDFILE=/run/alcyon.pid" "CFGDIR=/etc/alcyon/conf.d"
ExecStart=/usr/local/sbin/alcyon -Ws -f $CONFIG -f $CFGDIR -p $PIDFILE
# Check the new configuration first, so `systemctl reload` reports a broken one directly.
# Then SIGUSR2: the running process starts a new one, hands it the listening sockets, names
# it the main PID, and drains. USR1 here was a soft *stop* -- `systemctl reload` stopped
# the service, and Restart=always brought it back cold with every connection dropped.
ExecReload=/usr/local/sbin/alcyon -Ws -f $CONFIG -f $CFGDIR -c
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
Restart=always
SuccessExitStatus=143
Type=notify

[Install]
WantedBy=multi-user.target
