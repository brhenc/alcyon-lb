[Unit]
Description=Ibex Load Balancer
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/default/ibex
EnvironmentFile=-/etc/sysconfig/ibex
Environment="CONFIG=/etc/ibex/ibex.cfg" "PIDFILE=/run/ibex.pid" "CFGDIR=/etc/ibex/conf.d"
ExecStart=/usr/local/sbin/ibex -Ws -f $CONFIG -f $CFGDIR -p $PIDFILE
ExecReload=/usr/local/sbin/ibex -Ws -f $CONFIG -f $CFGDIR -c
ExecReload=/bin/kill -USR1 $MAINPID
KillMode=mixed
Restart=always
SuccessExitStatus=143
Type=notify

[Install]
WantedBy=multi-user.target
